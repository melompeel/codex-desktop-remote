<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexRemoteManager</AssemblyName>
    <RootNamespace>CodexRemoteManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.5.9</Version>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\android\artwork\app-icon.png" Link="Assets\app-icon.png" />
  </ItemGroup>
</Project>
